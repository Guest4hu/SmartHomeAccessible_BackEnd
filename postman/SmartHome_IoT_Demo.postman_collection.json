            },
            "description": "Retorna o catálogo de métricas lidas pelo dispositivo (`TEMPERATURE`, `HUMIDITY`, `LUMINOSITY`)."
          },
          "response": []
        },
        {
          "name": "07.2 - Consultar Histórico de Temperatura (Série Temporal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Série temporal possui dados\", function () {",
                  "    pm.expect(jsonData.metric).to.eql(\"TEMPERATURE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/metrics/TEMPERATURE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}", "metrics", "TEMPERATURE"]
            },
            "description": "Retorna a agregação temporal das temperaturas enviadas pelo sensor DHT22 do ESP32 a cada 5 segundos. O backend calcula automaticamente a resolução adequada (`RAW`, `HOUR` ou `DAY`)."
          },
          "response": []
        }
      ],
      "description": "Consulta de telemetria em formato longo e séries temporais analíticas."
    }
  ],
